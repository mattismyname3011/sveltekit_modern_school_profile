# Drizzle / Postgres
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Example for a local Postgres install:
#   postgres://postgres:postgres@localhost:5432/school_profile
DATABASE_URL="postgres://postgres:postgres@localhost:5432/school_profile"

# Admin token for write endpoints (POST/PATCH/DELETE on /api/*).
# Generate a strong random value, e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Must be at least 16 characters.
API_ADMIN_TOKEN=""
